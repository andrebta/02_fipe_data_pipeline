table _medidas
	lineageTag: a3266383-463f-432e-a569-01e75128f0ab

	measure preco_medio = DIVIDE(AVERAGE(fct_fipe_prices[valor_centavos]), 100)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: f2ca7c43-623d-4c23-85ae-60f2c7107833

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure qtd_veiculos =
			
			DISTINCTCOUNT(fct_fipe_prices[vehicle_key])
		formatString: 0
		lineageTag: 208f7215-1325-4ea3-ac15-c082dd0702b6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure qtd_cod_fipe =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_vehicle[codigo_fipe]),
			    CROSSFILTER(
			        dim_vehicle[vehicle_key],
			        fct_fipe_prices[vehicle_key],
			        BOTH
			    )
			)
		formatString: 0
		lineageTag: 292775da-196a-45d7-a440-263e0114b2c8

		annotation PBI_FormatHint = {"isDecimal":true}

	measure qtd_reg_precos = COUNTROWS(fct_fipe_prices)
		formatString: 0
		lineageTag: 7c07c545-dcce-44df-af36-909f477f8d4c

