	measure qtd_veiculos_variacao_abs =
			VAR CurrentVehicles =
			    [qtd_veiculos]
			
			VAR PreviousVehicles =
			    SWITCH(
			        TRUE(),
			
			        ISINSCOPE(dim_date[data]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, MONTH)
			            ),
			
			        ISINSCOPE(dim_date[ano_trimestre]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, QUARTER)
			            ),
			
			        ISINSCOPE(dim_date[ano_referencia]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, YEAR)
			            )
			    )
			
			RETURN
			    CurrentVehicles - PreviousVehicles
		formatString: #,0;-#,0;0
		lineageTag: a038f4e6-f56b-4de2-897b-239ee137b8b3

	measure ipca_acumulado_% =
			VAR MesesComIPCA =
			    FILTER(
			        VALUES(dim_date[date_key]),
			        NOT ISBLANK(
			            CALCULATE(
			                MAX(fct_ipca[ipca_mensal_pct])
			            )
			        )
			    )
			
			VAR QuantidadeMeses =
			    COUNTROWS(MesesComIPCA)
			
			RETURN
			    IF(
			        QuantidadeMeses = 0,
			        BLANK(),
			        PRODUCTX(
			            MesesComIPCA,
			            1 + CALCULATE(MAX(fct_ipca[ipca_mensal_pct]))
			        ) - 1
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 076e1e52-6175-466b-8c21-2bac107e0735

	measure ipca_mensal_% = MAX(fct_ipca[ipca_mensal_pct])
