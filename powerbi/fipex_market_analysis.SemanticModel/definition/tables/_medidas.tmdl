	measure chave_data_recente = MAX(fct_fipe_prices[date_key])
		formatString: 0
		lineageTag: 0b04e63e-c4a4-4130-a230-5a44f14ee6e6

	measure mediana_preco_variacao_% =
			
			VAR CurrentPrice =
			    [mediana_preco]
			
			VAR PreviousPrice =
			    SWITCH(
			        TRUE(),
			
			        ISINSCOPE(dim_date[data]),
			            CALCULATE(
			                [mediana_preco],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, MONTH)
			            ),
			
			        ISINSCOPE(dim_date[ano_trimestre]),
			            CALCULATE(
			                [mediana_preco],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, QUARTER)
			            ),
			
			        ISINSCOPE(dim_date[ano_referencia]),
			            CALCULATE(
			                [mediana_preco],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, YEAR)
			            )
			    )
			
			RETURN
			    DIVIDE(
			        CurrentPrice - PreviousPrice,
			        PreviousPrice
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 26f5fe1e-b69a-46b8-b6f2-264d3620a136

	measure mediana_preco = DIVIDE(MEDIAN(fct_fipe_prices[valor_centavos]), 100)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 0a7feaf3-aecb-4602-aa8b-17d367b1cea3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure rank_marca_mediana_preco =
			
			VAR MinVeiculos = 10
			
			VAR MarcasElegiveis =
			    FILTER(
			        ALLSELECTED(dim_vehicle[nome_marca]),
			        CALCULATE([qtd_veiculos]) >= MinVeiculos
			    )
			
			RETURN
			IF(
			    [qtd_veiculos] >= MinVeiculos,
			    RANKX(
			        MarcasElegiveis,
			        CALCULATE([mediana_preco]),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		lineageTag: 6de3a41c-b10e-4395-a8d1-5d1ce7e6034b

	measure qtd_veiculos_variacao_% =
			
			
			VAR CurrentVehicles =
			    [qtd_veiculos]
			
			VAR PreviousVehicles =
			    SWITCH(
			        TRUE(),
			
			        ISINSCOPE(dim_date[data]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, MONTH)
			            ),
			
			        ISINSCOPE(dim_date[ano_trimestre]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, QUARTER)
			            ),
			
			        ISINSCOPE(dim_date[ano_referencia]),
			            CALCULATE(
			                [qtd_veiculos],
			                REMOVEFILTERS(dim_date),
			                DATEADD(dim_date[data], -1, YEAR)
			            )
			    )
			
			RETURN
			    DIVIDE(
			        CurrentVehicles - PreviousVehicles,
			        PreviousVehicles
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 55f7bead-fdc7-4b30-8adb-cea058223ef7

