model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fct_fipe_prices","dim_vehicle","dim_date","fct_ipca"]

annotation PBI_ProTooling = ["DevMode"]

ref table fct_fipe_prices
ref table dim_vehicle
ref table dim_date
ref table fct_ipca
ref table _medidas
ref table 'Granularidade Data'


